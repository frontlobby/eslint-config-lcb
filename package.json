{
  "name": "@frontlobby/eslint-config-lcb",
  "version": "9.5.0",
  "description": "This holds the base shop standard ESLint configuration file.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontlobby/eslint-config-lcb.git"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.4.0",
    "lodash": "^4.17.21",
    "typescript": "^6.0.3",
    "vue-eslint-parser": "^10.4.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.1.0",
    "mocha": "^12.0.3",
    "typescript7": "npm:typescript@7.1.0-beta"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./base": "./baseRules.mjs"
  },
  "scripts": {
    "build": "node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "npm run build && eslint .",
    "typecheck": "node_modules/typescript7/bin/tsc --noEmit",
    "test": "npm run typecheck && mocha \"tests/**/*.mts\""
  }
}
